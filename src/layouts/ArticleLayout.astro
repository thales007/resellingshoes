---
export interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  readTime: string;
}
const { title, description, slug, category, readTime } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0J0XP4QN5Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0J0XP4QN5Q');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://resellingshoes.com/${slug}`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />

  <!-- Site config & CTA cards -->
  <script is:inline src="/js/site-config.js" defer></script>
  <script is:inline src="/js/cta-cards.js" defer></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --walnut: #C4943A;
      --charcoal: #1A1A1A;
      --cream: #faf8f5;
      --cream-dark: #f0ece4;
      --text-body: #2d2d2d;
      --text-muted: #6b6b6b;
      --max-w: 720px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--text-body);
      font-size: 17px;
      line-height: 1.75;
    }

    nav { border-bottom: 1px solid #e5e0d8; padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; background: var(--cream); position: sticky; top: 0; z-index: 100; }
    .nav-logo { font-family: 'DM Serif Display', serif; font-size: 20px; color: var(--charcoal); text-decoration: none; }
    .nav-logo span { color: var(--walnut); }
    .nav-links { display: flex; gap: 24px; list-style: none; }
    .nav-links a { font-size: 14px; font-weight: 500; color: var(--text-muted); text-decoration: none; }
    .nav-links a:hover { color: var(--walnut); }
    @media (max-width: 600px) { .nav-links { display: none; } }

    .breadcrumb { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; }
    .breadcrumb a { color: var(--walnut); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .article-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }

    .article-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--walnut);
      margin-bottom: 1rem;
    }

    .article-title {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2rem, 5vw, 2.75rem);
      line-height: 1.15;
      color: var(--charcoal);
      margin-bottom: 1.25rem;
    }

    .article-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #e5e0d8;
    }

    .article-body p { margin-bottom: 1.4rem; }
    .article-body h2 {
      font-family: 'DM Serif Display', serif;
      font-size: 1.65rem;
      color: var(--charcoal);
      margin: 2.75rem 0 1rem;
      line-height: 1.25;
    }
    .article-body a { color: var(--walnut); text-decoration: underline; text-underline-offset: 3px; }
    .article-body strong { color: var(--charcoal); }
    @media (max-width: 600px) {
      .article-body h2 { font-size: 1.4rem; }
    }
  </style>
</head>
<body>

<nav>
  <a class="nav-logo" href="/">Reselling<span>Shoes</span>.com</a>
  <ul class="nav-links">
    <li><a href="/1000-shoe-reselling-method">Free Guide</a></li>
    <li><a href="/the-everyday-shoe-flip">The Everyday Shoe Flip</a></li>
    <li><a href="https://solescore.app" target="_blank">SoleScore</a></li>
  </ul>
</nav>

<main class="article-wrap">
  <slot name="breadcrumb" />

  <p class="article-eyebrow">{category}</p>
  <h1 class="article-title">{title}</h1>
  <p class="article-meta">
    By <strong>Timothy Hales</strong> &nbsp;·&nbsp; ResellingShoes.com &nbsp;·&nbsp; {readTime}
  </p>

  <article class="article-body">
    <slot />
  </article>
</main>

<!-- Bottom CTAs -->
<div class="cta-card" data-card="free-guide"></div>
<div class="cta-card" data-card="paid-guide"></div>

<!-- Related articles -->
<div id="related-articles" data-category={category} data-current={slug}></div>
<script is:inline src="/js/articles-data.js"></script>
<script is:inline src="/js/related-articles.js"></script>

<!-- Footer -->
<div id="footer-root"></div>
<script is:inline src="/js/footer.js"></script>

</body>
</html>
