---
export interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  readTime: string;
}
const { title, description, slug, category, readTime } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0J0XP4QN5Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0J0XP4QN5Q');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://resellingshoes.com/${slug}`} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />

  <!-- Site config & CTA cards -->
  <script is:inline src="/js/site-config.js" defer></script>
  <script is:inline src="/js/cta-cards.js" defer></script>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --walnut: #C4943A;
      --charcoal: #1A1A1A;
      --cream: #faf8f5;
      --cream-dark: #f0ece4;
      --text-body: #2d2d2d;
      --text-muted: #6b6b6b;
      --border: #e5e0d8;
      --bg-soft: #f0ece4;
      --red: #c0392b;
      --green-profit: #2e7d52;
      --max-w: 720px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--text-body);
      font-size: 17px;
      line-height: 1.75;
    }

    nav { border-bottom: 1px solid var(--border); padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; background: var(--cream); position: sticky; top: 0; z-index: 100; }
    .nav-logo { font-family: 'DM Serif Display', serif; font-size: 20px; color: var(--charcoal); text-decoration: none; }
    .nav-logo span { color: var(--walnut); }
    .nav-links { display: flex; gap: 24px; list-style: none; }
    .nav-links a { font-size: 14px; font-weight: 500; color: var(--text-muted); text-decoration: none; }
    .nav-links a:hover { color: var(--walnut); }
    .nav-links .nav-cta { background: var(--green); color: #fff; padding: 9px 18px; border-radius: 8px; font-weight: 700; }
    .nav-links .nav-cta:hover { background: var(--green-hover); color: #fff; }
    @media (max-width: 600px) { .nav-links li:not(:last-child) { display: none; } }

    .breadcrumb { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; }
    .breadcrumb a { color: var(--walnut); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .article-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }

    .article-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--walnut);
      margin-bottom: 1rem;
    }

    .article-title {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2rem, 5vw, 2.75rem);
      line-height: 1.15;
      color: var(--charcoal);
      margin-bottom: 1.25rem;
    }

    .article-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }

    /* ── Article body base ── */
    .article-body img {
      max-width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
      border: 1px solid var(--border);
      margin: 1.75rem 0 0.5rem;
    }
    .article-body p { margin-bottom: 1.4rem; }
    .article-body h2 {
      font-family: 'DM Serif Display', serif;
      font-size: 1.65rem;
      color: var(--charcoal);
      margin: 2.75rem 0 1rem;
      line-height: 1.25;
    }
    .article-body h3 { font-size: 1.1rem; font-weight: 700; color: var(--charcoal); margin: 1.5rem 0 0.5rem; }
    .article-body a { color: var(--walnut); text-decoration: underline; text-underline-offset: 3px; }
    .article-body strong { color: var(--charcoal); }
    .article-body ul, .article-body ol { padding-left: 1.5rem; margin-bottom: 1.4rem; }
    .article-body li { margin-bottom: 0.5rem; }
    .article-body blockquote {
      border-left: 3px solid var(--walnut);
      padding: 0.25rem 0 0.25rem 1.25rem;
      margin: 1.75rem 0;
      color: var(--text-muted);
      font-style: italic;
    }

    /* ── Pull quote ── */
    .pull-quote { border-left: 3px solid var(--walnut); padding: 0.25rem 0 0.25rem 1.25rem; margin: 1.75rem 0; }
    .pull-quote p { font-family: 'DM Serif Display', serif; font-size: 1.2rem; color: var(--charcoal); font-style: italic; margin: 0; }

    /* ── Steps ── */
    .steps { margin: 28px 0; }
    .step { display: flex; gap: 20px; margin-bottom: 28px; align-items: flex-start; }
    .step-num {
      flex-shrink: 0; width: 36px; height: 36px;
      background: var(--walnut); color: #fff;
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 14px;
    }
    .step-content h3 { margin-top: 0; font-family: 'DM Serif Display', serif; font-size: 1.1rem; }

    /* ── Step box (numbered list variant) ── */
    .step-box { background: var(--cream-dark); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
    .step-box h3 { font-family: 'DM Serif Display', serif; font-size: 1.1rem; color: var(--charcoal); margin-bottom: 0.75rem; }
    .step-row { display: flex; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--border); align-items: flex-start; }
    .step-row:last-child { border-bottom: none; }
    .step-row .step-num { font-weight: 700; color: var(--walnut); min-width: 24px; background: none; height: auto; width: auto; border-radius: 0; font-size: 14px; }

    /* ── Profit example ── */
    .profit-example { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; margin: 1.5rem 0; }
    .profit-example-label { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.75rem; }
    .profit-row { display: flex; justify-content: space-between; font-size: 15px; padding: 0.4rem 0; border-bottom: 1px solid var(--border); }
    .profit-row:last-child { border-bottom: none; font-weight: 700; color: var(--charcoal); }
    .profit-row.negative span:last-child { color: var(--red); }
    .profit-row.positive span:last-child { color: var(--green-profit); font-weight: 700; }
    .profit { color: #5ecb8a; font-weight: 600; }

    /* ── Profit / sale dark box ── */
    .profit-box, .sale-box {
      background: var(--charcoal); color: #fff;
      border-radius: 12px; padding: 1.5rem;
      margin: 1.75rem 0;
    }
    .profit-box-label, .sale-box-label {
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 0.5rem;
    }
    .profit-box-title, .sale-box-title {
      font-family: 'DM Serif Display', serif; font-size: 1.25rem; margin-bottom: 1rem;
    }
    .profit-box-note, .sale-box-note {
      font-size: 0.82rem; color: rgba(255,255,255,0.5); margin-top: 0.75rem;
    }
    .profit-grid, .sale-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.75rem; margin-bottom: 0.5rem;
    }
    .profit-stat, .sale-stat { background: rgba(255,255,255,0.07); border-radius: 8px; padding: 0.75rem; }
    .profit-stat-label, .sale-stat-label { font-size: 0.7rem; color: rgba(255,255,255,0.5); margin-bottom: 0.25rem; }
    .profit-stat-value, .sale-stat-value { font-size: 1.3rem; font-weight: 600; color: #fff; }
    .profit-stat-value.green, .sale-stat-value.green { color: #5ecb8a; }

    /* ── Brand table ── */
    .brand-table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 14px; }
    .brand-table th { text-align: left; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); padding: 8px 12px; border-bottom: 2px solid var(--border); }
    .brand-table td { padding: 12px; border-bottom: 1px solid var(--border); }
    .brand-table tr:last-child td { border-bottom: none; }
    .brand-table tr:hover td { background: var(--bg-soft); }

    /* ── Compare table ── */
    .compare-table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 15px; }
    .compare-table th { text-align: left; padding: 0.65rem 1rem; background: var(--cream-dark); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; }
    .compare-table td { padding: 0.65rem 1rem; border-bottom: 1px solid var(--border); }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:nth-child(even) td { background: var(--cream-dark); }
    @media (max-width: 600px) { .compare-table { font-size: 0.8rem; } .compare-table th, .compare-table td { padding: 0.5rem 0.65rem; } }

    /* ── Checklist box ── */
    .checklist-box { background: var(--cream-dark); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
    .checklist-box h3 { font-family: 'DM Serif Display', serif; font-size: 1.05rem; color: var(--charcoal); margin-bottom: 0.75rem; }
    .checklist-item { display: flex; gap: 0.65rem; padding: 0.55rem 0; border-bottom: 1px solid var(--border); font-size: 15px; align-items: flex-start; }
    .checklist-item:last-child { border-bottom: none; }
    .checklist-x { color: var(--red); font-weight: 600; flex-shrink: 0; }

    /* ── Platform cards ── */
    .platform-card { background: var(--cream-dark); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
    .platform-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem; }
    .platform-name { font-family: 'DM Serif Display', serif; font-size: 1.2rem; color: var(--charcoal); }
    .platform-tag { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 100px; }
    .tag-primary { background: #e8f0e8; color: #2f7a4f; }
    .tag-secondary { background: var(--cream-dark); border: 1px solid var(--border); color: var(--text-muted); }
    .tag-situational { background: #fef5e6; color: #8a5f1a; }
    .tag-optional { background: #f0ecf8; color: #5a3d8a; }
    .platform-fee { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.65rem; }
    .platform-fee strong { color: var(--charcoal); }
    .platform-body { font-size: 0.95rem; color: var(--text-body); }
    .platform-body p { margin-bottom: 0.85rem; }
    .platform-body p:last-child { margin-bottom: 0; }

    /* ── Brand pills ── */
    .brand-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
    .brand-pill { background: rgba(196,148,58,0.1); border: 1px solid rgba(196,148,58,0.25); color: var(--charcoal); font-size: 13px; font-weight: 600; padding: 5px 12px; border-radius: 100px; }

    /* ── Highlight ── */
    .highlight { color: var(--walnut); font-size: 1.05rem; }

    /* ── Article bottom ── */
    .article-bottom {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .related-strip {
      border-top: 1px solid var(--border);
      padding-top: 2rem;
      margin-bottom: 2.5rem;
    }
    .related-strip-heading {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }
    .related-strip-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .related-strip-grid a {
      display: block;
      text-decoration: none;
      color: var(--charcoal);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.35;
      transition: border-color 0.15s;
    }
    .related-strip-grid a:hover { border-color: var(--walnut); }

    .free-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: #f5ecd8;
      border: 1px solid rgba(196,148,58,0.3);
      border-radius: 12px;
      padding: 20px 24px;
      text-decoration: none;
    }
    .free-banner-text { flex: 1; min-width: 0; }
    .free-banner-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--walnut);
      margin-bottom: 4px;
    }
    .free-banner-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.05rem;
      color: var(--charcoal);
      margin-bottom: 2px;
    }
    .free-banner-sub {
      font-size: 13px;
      color: #7a6640;
    }
    .free-banner-btn {
      flex-shrink: 0;
      background: var(--walnut);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      padding: 11px 20px;
      border-radius: 8px;
      text-decoration: none;
      white-space: nowrap;
    }
    .free-banner-btn:hover { opacity: 0.88; }

    @media (max-width: 600px) {
      .article-body h2 { font-size: 1.4rem; }
      .profit-grid, .sale-grid { grid-template-columns: 1fr 1fr; }
      .step { gap: 14px; }
      .related-strip-grid { grid-template-columns: 1fr; }
      .free-banner { flex-direction: column; align-items: flex-start; gap: 14px; }
      .free-banner-btn { width: 100%; text-align: center; padding: 13px 20px; }
    }
  </style>
</head>
<body>

<nav>
  <a class="nav-logo" href="/">Reselling<span>Shoes</span>.com</a>
  <ul class="nav-links">
    <li><a href="/learn">Learn</a></li>
    <li><a href="/the-everyday-shoe-flip">The Playbook</a></li>
    <li><a href="/1000-shoe-reselling-method" class="nav-cta">Free Guide</a></li>
  </ul>
</nav>

<main class="article-wrap">
  <slot name="breadcrumb" />

  <p class="article-eyebrow">{category}</p>
  <h1 class="article-title">{title}</h1>
  <p class="article-meta">
    By <strong>Timothy Hales</strong> &nbsp;·&nbsp; ResellingShoes.com &nbsp;·&nbsp; {readTime}
  </p>

  <article class="article-body">
    <slot />
  </article>
</main>

<div class="article-bottom">
  <!-- Related articles first -->
  <div id="related-articles-mount" data-category={category} data-current={slug}></div>

  <!-- Single slim free-guide banner -->
  <a href="/1000-shoe-reselling-method" class="free-banner">
    <div class="free-banner-text">
      <div class="free-banner-label">Free · Instant PDF</div>
      <div class="free-banner-title">The $1,000 Shoe Reselling Method</div>
      <div class="free-banner-sub">The brands, profit math, and sourcing strategy — 16 pages.</div>
    </div>
    <span class="free-banner-btn">Get it free →</span>
  </a>
</div>

<script is:inline src="/js/articles-data.js"></script>
<script is:inline>
(function() {
  var mount = document.getElementById('related-articles-mount');
  if (!mount || typeof ARTICLES_DATA === 'undefined') return;
  var category = mount.getAttribute('data-category');
  var current = mount.getAttribute('data-current');
  var related = ARTICLES_DATA.filter(function(a) {
    return a.category === category && a.slug !== current && !a.comingSoon;
  }).slice(0, 3);
  if (related.length === 0) return;
  var html = '<div class="related-strip"><div class="related-strip-heading">More in ' + category + '</div>';
  html += '<div class="related-strip-grid">';
  related.forEach(function(a) {
    html += '<a href="' + a.url + '">' + a.title + '</a>';
  });
  html += '</div></div>';
  mount.innerHTML = html;
})();
</script>

<!-- Footer -->
<div id="footer-root"></div>
<script is:inline src="/js/footer.js"></script>

</body>
</html>
