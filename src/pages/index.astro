---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => !a.data.comingSoon)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const bySlug = Object.fromEntries(articles.map(a => [a.id.replace(/\.md$/, ''), a.data]));

const START_HERE = [
  {
    slug: 'is-reselling-shoes-profitable',
    label: 'Is This Actually Worth It?',
    blurb: 'An honest look at real profit numbers before you get started.',
  },
  {
    slug: 'how-to-start-reselling-shoes',
    label: 'How to Start Reselling Shoes',
    blurb: 'The exact first steps, from sourcing to your first sale.',
  },
  {
    slug: 'best-shoes-to-resell',
    label: 'What Shoes to Look For',
    blurb: 'The brands and models that actually sell — and the ones that don\'t.',
  },
  {
    slug: 'where-to-sell-used-shoes',
    label: 'Where to Sell Them',
    blurb: 'eBay, Poshmark, and Mercari compared, so you pick right the first time.',
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0J0XP4QN5Q"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-0J0XP4QN5Q');
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ResellingShoes.com — Flip Everyday Shoes for Real Profit</title>
<meta name="description" content="Learn to flip everyday thrift-store and yard-sale shoes for profit. Real brands, real numbers, real strategy — no hype sneakers.">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://resellingshoes.com/">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
<meta property="og:title" content="ResellingShoes.com — Flip Everyday Shoes for Real Profit">
<meta property="og:description" content="A practical, no-fluff resource for making money reselling shoes from thrift stores. Real brands, real profit math, real strategy.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,800;1,9..40,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink: #1A1A1A; --ink-2: #3A3630; --ink-3: #6b6b6b; --ink-4: #A39D97;
    --cream: #faf8f5; --cream-dark: #f0ece4; --border: #e5e0d8;
    --walnut: #C4943A; --walnut-light: #fdf6e7;
    --green: #2F8B5C; --green-hover: #267049; --green-light: #e8f5ef;
    --serif: 'DM Serif Display', Georgia, serif;
    --sans: 'DM Sans', sans-serif;
  }
  body { font-family: var(--sans); background: var(--cream); color: var(--ink); line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  a { text-decoration: none; color: inherit; }

  /* ── NAV ─────────────────────────────────────────── */
  nav {
    background: rgba(250,248,245,0.95); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border); padding: 0 32px; height: 68px;
    display: flex; align-items: center; justify-content: space-between;
    position: sticky; top: 0; z-index: 100;
  }
  .nav-brand { display: flex; flex-direction: column; justify-content: center; }
  .nav-wordmark { font-weight: 800; font-size: 18px; color: var(--ink); line-height: 1.1; }
  .nav-wordmark .g { color: var(--green); }
  .nav-tagline { font-size: 10px; color: var(--ink-4); font-weight: 500; margin-top: 1px; letter-spacing: 0.01em; }
  .nav-links { display: flex; align-items: center; gap: 28px; }
  .nav-links a { font-size: 14px; font-weight: 500; color: var(--ink-3); }
  .nav-links a:hover { color: var(--ink); }
  .nav-cta { background: var(--green) !important; color: #fff !important; padding: 9px 18px; border-radius: 8px; font-weight: 700 !important; }
  .nav-cta:hover { background: var(--green-hover) !important; }
  @media (max-width: 600px) { .nav-links a:not(.nav-cta) { display: none; } }

  /* ── HERO ────────────────────────────────────────── */
  .hero { max-width: 780px; margin: 0 auto; padding: 80px 32px 72px; text-align: center; }
  .hero h1 {
    font-family: var(--serif); font-size: 52px; line-height: 1.1;
    margin-bottom: 22px; color: var(--ink);
  }
  .hero-sub {
    font-size: 18px; line-height: 1.65; color: var(--ink-3);
    max-width: 580px; margin: 0 auto 36px;
  }
  .hero-actions { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--green); color: #fff; padding: 14px 30px;
    border-radius: 9px; font-size: 16px; font-weight: 700; border: none; cursor: pointer;
  }
  .btn-primary:hover { background: var(--green-hover); }
  .hero-text-link { font-size: 15px; font-weight: 600; color: var(--ink-3); }
  .hero-text-link:hover { color: var(--ink); }
  @media (max-width: 680px) { .hero h1 { font-size: 36px; } .hero-sub { font-size: 16px; } }

  /* ── START HERE ──────────────────────────────────── */
  #start-here { background: var(--cream-dark); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 72px 32px; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .section-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); margin-bottom: 10px; }
  .section-title { font-family: var(--serif); font-size: 34px; line-height: 1.15; margin-bottom: 36px; color: var(--ink); }
  .start-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .start-card {
    display: block; background: #fff; border: 1px solid var(--border); border-radius: 14px;
    padding: 24px; transition: box-shadow 0.15s, border-color 0.15s;
  }
  .start-card:hover { box-shadow: 0 6px 20px -8px rgba(0,0,0,0.12); border-color: #d0cac0; }
  .start-num { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green); margin-bottom: 12px; }
  .start-card h3 { font-family: var(--serif); font-size: 19px; line-height: 1.2; margin-bottom: 10px; color: var(--ink); }
  .start-card p { font-size: 14px; color: var(--ink-3); line-height: 1.55; margin-bottom: 16px; }
  .start-arrow { font-size: 13px; font-weight: 700; color: var(--green); }
  @media (max-width: 860px) { .start-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .start-grid { grid-template-columns: 1fr; } }

  /* ── FEATURED ARTICLES ───────────────────────────── */
  #articles { padding: 72px 32px; }
  .articles-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 16px; }
  .articles-header-left .section-title { margin-bottom: 0; }
  .articles-browse { font-size: 14px; font-weight: 600; color: var(--green); }
  .articles-browse:hover { color: var(--green-hover); }
  .article-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .article-card {
    display: block; background: #fff; border: 1px solid var(--border); border-radius: 14px;
    padding: 24px; transition: box-shadow 0.15s, border-color 0.15s;
  }
  .article-card:hover { box-shadow: 0 6px 20px -8px rgba(0,0,0,0.12); border-color: #d0cac0; }
  .article-cat { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--walnut); margin-bottom: 12px; }
  .article-card h3 { font-family: var(--serif); font-size: 18px; line-height: 1.25; margin-bottom: 10px; color: var(--ink); }
  .article-card p { font-size: 14px; color: var(--ink-3); line-height: 1.55; margin-bottom: 14px; }
  .article-read { font-size: 13px; color: var(--ink-4); }
  @media (max-width: 860px) { .article-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .article-grid { grid-template-columns: 1fr; } }

  /* ── WHY LISTEN ──────────────────────────────────── */
  #why { background: var(--cream-dark); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 72px 32px; }
  .why-inner { max-width: 680px; margin: 0 auto; }
  .why-inner .section-title { margin-bottom: 20px; }
  .why-copy { font-size: 17px; line-height: 1.7; color: var(--ink-2); margin-bottom: 24px; }
  .why-link { font-size: 15px; font-weight: 700; color: var(--green); }
  .why-link:hover { color: var(--green-hover); }

  /* ── WANT MORE STRUCTURE ─────────────────────────── */
  #structure { padding: 72px 32px; }
  .structure-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  .structure-card {
    background: #fff; border: 1px solid var(--border); border-radius: 16px;
    padding: 30px; display: flex; flex-direction: column;
  }
  .structure-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 14px; }
  .structure-tag.free { color: var(--green); }
  .structure-tag.paid { color: var(--walnut); }
  .structure-tag.tool { color: var(--ink-3); }
  .structure-card h3 { font-family: var(--serif); font-size: 20px; line-height: 1.2; margin-bottom: 12px; color: var(--ink); }
  .structure-card p { font-size: 14px; color: var(--ink-3); line-height: 1.55; flex: 1; margin-bottom: 20px; }
  .structure-link { font-size: 14px; font-weight: 700; color: var(--green); align-self: flex-start; }
  .structure-link:hover { color: var(--green-hover); }
  @media (max-width: 860px) { .structure-grid { grid-template-columns: 1fr; } }

  /* ── SHARED ──────────────────────────────────────── */
  @media (max-width: 560px) {
    #start-here, #articles, #why, #structure { padding-left: 20px; padding-right: 20px; }
    .hero { padding-left: 20px; padding-right: 20px; }
    nav { padding-left: 20px; padding-right: 20px; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" class="nav-brand">
    <div class="nav-wordmark">Reselling<span class="g">Shoes</span></div>
    <div class="nav-tagline">Your source for shoe reselling tips.</div>
  </a>
  <div class="nav-links">
    <a href="https://solescore.app" target="_blank" rel="noopener noreferrer">SoleScore</a>
    <a href="/the-everyday-shoe-flip">The Everyday Shoe Flip</a>
    <a href="/1000-shoe-reselling-method" class="nav-cta">Free Guide</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <h1>Helping you turn everyday shoes into a dependable income</h1>
  <p class="hero-sub">I buy everyday shoes — New Balance, HOKA, Brooks, Skechers — from thrift stores and yard sales, then resell them on eBay and Poshmark. This site is everything I've learned doing it, based on what's actually worked.</p>
  <div class="hero-actions">
    <a href="#start-here" class="btn-primary">Start Here</a>
    <a href="/learn" class="hero-text-link">Browse all articles →</a>
  </div>
</section>

<!-- START HERE -->
<section id="start-here">
  <div class="section-inner">
    <div class="section-eyebrow">Start Here</div>
    <div class="section-title">New here? Start with these.</div>
    <div class="start-grid">
      {START_HERE.map((item, i) => {
        const data = bySlug[item.slug];
        return (
          <a href={`/${item.slug}`} class="start-card">
            <div class="start-num">0{i + 1}</div>
            <h3>{item.label}</h3>
            <p>{item.blurb}</p>
            <span class="start-arrow">Read →</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- FEATURED ARTICLES -->
<section id="articles">
  <div class="section-inner">
    <div class="articles-header">
      <div class="articles-header-left">
        <div class="section-eyebrow">Articles</div>
        <div class="section-title">Everything on the site.</div>
      </div>
      <a href="/learn" class="articles-browse">Browse all →</a>
    </div>
    <div class="article-grid">
      {articles.map(article => {
        const slug = article.id.replace(/\.md$/, '');
        return (
          <a href={`/${slug}`} class="article-card">
            <div class="article-cat">{article.data.category}</div>
            <h3>{article.data.title}</h3>
            <p>{article.data.blurb}</p>
            <span class="article-read">{article.data.readTime}</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- WHY LISTEN TO ME -->
<section id="why">
  <div class="why-inner">
    <div class="section-eyebrow">About</div>
    <div class="section-title">Why listen to me?</div>
    <p class="why-copy">I'm Timothy — I have a full-time job, and reselling shoes is something I do on the side. I started because I needed extra income, and thrift-store and yard-sale shoes turned out to be one of the more reliable ways to make it. Everything on this site comes from what I've actually done — no hype sneakers, no guessing, just what's worked.</p>
    <a href="/about" class="why-link">Read my full story →</a>
  </div>
</section>

<!-- WANT MORE STRUCTURE -->
<section id="structure">
  <div class="section-inner">
    <div class="section-eyebrow">Resources</div>
    <div class="section-title">Want more structure?</div>
    <div class="structure-grid">
      <div class="structure-card">
        <div class="structure-tag free">Free Guide</div>
        <h3>The $1,000 Shoe Reselling Method</h3>
        <p>A free walkthrough of how I'd get to my first $1,000 in resale profit if I were starting today.</p>
        <a href="/1000-shoe-reselling-method" class="structure-link">Get the free guide →</a>
      </div>
      <div class="structure-card">
        <div class="structure-tag paid">$17 Guide</div>
        <h3>The Everyday Shoe Flip</h3>
        <p>The complete system, start to finish — sourcing to shipping. $17.</p>
        <a href="https://shop.resellingshoes.com/l/the-everyday-shoe-flip" target="_blank" rel="noopener noreferrer" class="structure-link">See what's inside →</a>
      </div>
      <div class="structure-card">
        <div class="structure-tag tool">Free Tool</div>
        <h3>SoleScore</h3>
        <p>A free tool that tells you in seconds whether a shoe's worth buying to resell.</p>
        <a href="https://solescore.app" target="_blank" rel="noopener noreferrer" class="structure-link">Try SoleScore →</a>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<div id="footer-root"></div>
<script is:inline src="/js/footer.js"></script>
<script is:inline src="/js/site-config.js"></script>

</body>
</html>
